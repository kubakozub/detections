from * metadata _id, _index, _version | where (http.request.method=="DELETE" or http.request.method=="POST" and url.query like "*_method=DELETE*") and (url.path like "*/wp/v2/media/*" or url.query like "*rest_route=/wp/v2/media/*" or url.query like "*rest_route=%2Fwp%2Fv2%2Fmedia%2F*") and http.response.status_code==200 or (ends_with(url.path, "/wp-admin/post.php") or ends_with(url.path, "/wp-admin/upload.php")) and url.query like "*action=delete*" and http.response.status_code==302
