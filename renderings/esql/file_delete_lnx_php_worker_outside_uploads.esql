from * metadata _id, _index, _version | where event.category=="file" and event.type=="deletion" and (process.executable like "*/php-fpm*" or ends_with(process.executable, "/apache2") or ends_with(process.executable, "/httpd") or ends_with(process.executable, "/lsphp") or ends_with(process.executable, "/frankenphp")) and not (file.path like "*/wp-content/uploads/*" or starts_with(file.path, "/tmp/") or starts_with(file.path, "/var/tmp/") or starts_with(file.path, "/dev/shm/") or starts_with(file.path, "/run/") or file.path like "*/sessions/sess_*") and not (file.path like "*/wp-content/cache/*" or file.path like "*/wp-content/upgrade/*" or file.path like "*/wp-content/upgrade-temp-backup/*")
