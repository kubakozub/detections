from * metadata _id, _index, _version | where http.request.method=="POST" and http.response.status_code==200 and (url.path like "*/wp/v2/media/*" and (ends_with(url.path, "/finalize") or ends_with(url.path, "/finalize/")) or (url.query like "*rest_route=/wp/v2/media/*" or url.query like "*rest_route=%2Fwp%2Fv2%2Fmedia%2F*") and (url.query like "*/finalize*" or url.query like "*%2Ffinalize*"))
