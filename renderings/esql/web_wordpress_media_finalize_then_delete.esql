from * metadata _id, _index, _version | where (http.request.method=="POST" and http.response.status_code==200 and (url.path like "*/wp/v2/media/*" and (ends_with(url.path, "/finalize") or ends_with(url.path, "/finalize/")) or (url.query like "*rest_route=/wp/v2/media/*" or url.query like "*rest_route=%2Fwp%2Fv2%2Fmedia%2F*") and (url.query like "*/finalize*" or url.query like "*%2Ffinalize*"))) or ((http.request.method=="DELETE" or http.request.method=="POST" and url.query like "*_method=DELETE*") and (url.path like "*/wp/v2/media/*" or url.query like "*rest_route=/wp/v2/media/*" or url.query like "*rest_route=%2Fwp%2Fv2%2Fmedia%2F*") and http.response.status_code==200 or (ends_with(url.path, "/wp-admin/post.php") or ends_with(url.path, "/wp-admin/upload.php")) and url.query like "*action=delete*" and http.response.status_code==302)
| eval event_type=case(http.request.method=="POST" and http.response.status_code==200 and (url.path like "*/wp/v2/media/*" and (ends_with(url.path, "/finalize") or ends_with(url.path, "/finalize/")) or (url.query like "*rest_route=/wp/v2/media/*" or url.query like "*rest_route=%2Fwp%2Fv2%2Fmedia%2F*") and (url.query like "*/finalize*" or url.query like "*%2Ffinalize*")), "wordpress_media_finalize_request", (http.request.method=="DELETE" or http.request.method=="POST" and url.query like "*_method=DELETE*") and (url.path like "*/wp/v2/media/*" or url.query like "*rest_route=/wp/v2/media/*" or url.query like "*rest_route=%2Fwp%2Fv2%2Fmedia%2F*") and http.response.status_code==200 or (ends_with(url.path, "/wp-admin/post.php") or ends_with(url.path, "/wp-admin/upload.php")) and url.query like "*action=delete*" and http.response.status_code==302, "wordpress_media_delete_request")
| eval timebucket=date_trunc(15minutes, @timestamp) | stats event_type_count=count_distinct(event_type) by timebucket, source.ip
| where event_type_count >= 2
