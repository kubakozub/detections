DeviceFileEvents
| where ActionType =~ "FileDeleted" and ((InitiatingProcessFolderPath contains "/php-fpm" or (InitiatingProcessFolderPath endswith "/apache2" or InitiatingProcessFolderPath endswith "/httpd" or InitiatingProcessFolderPath endswith "/lsphp" or InitiatingProcessFolderPath endswith "/frankenphp")) and (not((FolderPath contains "/wp-content/uploads/" or (FolderPath startswith "/tmp/" or FolderPath startswith "/var/tmp/" or FolderPath startswith "/dev/shm/" or FolderPath startswith "/run/") or FolderPath contains "/sessions/sess_"))) and (not((FolderPath contains "/wp-content/cache/" or (FolderPath contains "/wp-content/upgrade/" or FolderPath contains "/wp-content/upgrade-temp-backup/")))))
