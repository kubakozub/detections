let window = 15m;
let finalize = AppServiceHTTPLogs
| where (CsMethod =~ "POST" and ScStatus == 200) and ((CsUriStem contains "/wp/v2/media/" and (CsUriStem endswith "/finalize" or CsUriStem endswith "/finalize/")) or ((CsUriQuery contains "rest_route=/wp/v2/media/" or CsUriQuery contains "rest_route=%2Fwp%2Fv2%2Fmedia%2F") and (CsUriQuery contains "/finalize" or CsUriQuery contains "%2Ffinalize")))
| project FinalizeTime = TimeGenerated, CIp, FinalizeUri = strcat(CsUriStem, "?", CsUriQuery);
let deletes = AppServiceHTTPLogs
| where ((CsMethod =~ "DELETE" or (CsMethod =~ "POST" and CsUriQuery contains "_method=DELETE")) and (CsUriStem contains "/wp/v2/media/" or (CsUriQuery contains "rest_route=/wp/v2/media/" or CsUriQuery contains "rest_route=%2Fwp%2Fv2%2Fmedia%2F")) and ScStatus == 200) or (((CsUriStem endswith "/wp-admin/post.php" or CsUriStem endswith "/wp-admin/upload.php") and CsUriQuery contains "action=delete") and ScStatus == 302)
| project DeleteTime = TimeGenerated, CIp, DeleteUri = strcat(CsUriStem, "?", CsUriQuery);
finalize
| join kind=inner deletes on CIp
| where abs(DeleteTime - FinalizeTime) <= window
| summarize FirstSeen = min(min_of(FinalizeTime, DeleteTime)), LastSeen = max(max_of(FinalizeTime, DeleteTime)),
    Finalized = make_set(FinalizeUri), Deleted = make_set(DeleteUri) by CIp
